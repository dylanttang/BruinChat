{
  "expo": {
    "name": "BChat",
    "slug": "bchat",
    "scheme": "bchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F1",
      "dark": {
        "image": "./src/assets/splash-icon.png",
        "backgroundColor": "#17161F"
      }
    },
    "ios": {
      "bundleIdentifier": "com.bchatdevx.bchat",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bchatdevx.bchat",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F1"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#FE7A45"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BChat needs access to your photos so you can share them in class chats and set a profile picture.",
          "cameraPermission": "BChat needs camera access so you can take photos and videos to share in class chats.",
          "microphonePermission": "BChat needs microphone access to record sound when you take videos to share in class chats."
        }
      ]
    ]
  }
}
