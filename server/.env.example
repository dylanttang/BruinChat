PORT=3000

# --- Database -------------------------------------------------------------
# Replace with your Atlas URI - never commit real credentials
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bruinchat?retryWrites=true&w=majority
# Optional: override the database name from the URI (e.g. for staging vs prod)
# MONGODB_DB=bruinchat

# --- Auth -----------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Local development only: turns on the "Skip (Dev)" user picker, which lets
# anyone sign in as any user. Ignored when NODE_ENV=production. Needs
# JWT_SECRET above to be set. Leave unset on any deployed server.
DEV_AUTH=true
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Optional, depending on which clients your Expo app uses
# GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# --- Cloudinary (image/avatar uploads) ------------------------------------
# Required for /api/upload/signature to work. Get these from your Cloudinary
# dashboard. Never commit the real api_secret.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Misc -----------------------------------------------------------------
# Optional: your machine's URL for mobile testing (e.g. http://192.168.1.100:3000) - only used in server logs
# SERVER_PUBLIC_URL=http://YOUR_IP:3000

# Optional: rate limit shadow mode. When "true", limits are logged but not
# enforced. Useful for tuning limits with real traffic before going live.
# RATE_LIMIT_SHADOW=true

# Comma-separated exact browser origins. Native apps may omit Origin.
# Use HTTPS origins in production; include localhost explicitly for web development.
CORS_ORIGINS=
